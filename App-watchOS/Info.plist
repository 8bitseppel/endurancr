<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>endurancr</string>
    <key>CFBundleDisplayName</key>
    <string>endurancr</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>app.endurancr</string>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>endurancr uses your location only while you record a run, to measure distance and map your route. Your route stays on your devices and in Apple Health.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>endurancr reads your heart rate, distance and energy from Apple Health while you run so it can show live metrics and record the workout. This data stays on your devices and is never sent anywhere.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>endurancr saves the runs it records (workout, heart rate, distance, energy and GPS route) to Apple Health. Nothing leaves your devices.</string>
</dict>
</plist>
